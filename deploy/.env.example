# Copy to .env beside docker-compose.yml and fill every value. This file
# documents names only; values are never committed (rules R2 and R0,
# .claude/rules/project-rules.json).

# Postgres connection URL the API uses, shape:
# postgresql+psycopg://USER:PASSWORD@postgres:5432/DBNAME
DATABASE_URL=

# Signs session cookies (E0.6). Generate: openssl rand -base64 32
EOE_SESSION_SECRET=

# Base64 platform key-encryption key for SecretStore (E0.11, spec 12.4).
# Generate: openssl rand -base64 32
EOE_KEK=

# Optional; enables Redis-backed features when they arrive (E3, E7).
REDIS_URL=

# Dev Postgres container credentials (compose only; keep consistent with
# DATABASE_URL above).
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
