# Copy to .env beside docker-compose.yml and fill every value. This file
# documents names only; values are never committed (rules R2 and R0,
# .claude/rules/project-rules.json).

# Postgres connection URL the API uses, shape:
# postgresql+psycopg://USER:PASSWORD@postgres:5432/DBNAME
DATABASE_URL=

# Signs session cookies (E0.6). Generate: openssl rand -base64 32
EOE_SESSION_SECRET=

# Base64 platform key-encryption key for SecretStore (E0.11, spec 12.4).
# Generate: openssl rand -base64 32
EOE_KEK=

# Optional; enables Redis-backed features when they arrive (E3, E7).
REDIS_URL=

# Comma-separated browser origins allowed to call the API with credentials
# (decisions D2/D4). Compose defaults this to http://localhost:5173.
EOE_CORS_ORIGINS=

# Optional session lifetime in seconds; defaults to 43200 (12 hours).
EOE_SESSION_TTL_SECONDS=

# Gates config-revision publication (E2.6/D56; default off). E2's apply
# always stops at draft revisions; E3 flips this when its publisher lands.
# It also gates the API's outbound broker connection: with it off the API
# opens none, because nothing it could publish would be allowed out.
EOE_PUBLISH_ENABLED=

# Optional (E3.7/D59): run the reconciliation worker inside the API process
# instead of as its own container. Default off; compose runs the `worker`
# service. Turning this on in more than one API replica would give one
# deployment two workers.
EOE_WORKER_IN_API=

# Optional (E3.7): seconds between reconciliation sweeps. The timeout sweep
# fails out pending revisions past their deployment's window (default 30s
# cadence); the drift sweep re-compares applied devices (default 300s). The
# WINDOW itself is per deployment (deployment.pending_timeout_seconds).
EOE_TIMEOUT_SWEEP_SECONDS=
EOE_DRIFT_SWEEP_SECONDS=

# Where the standalone worker writes its liveness stamp, which the compose
# healthcheck reads the age of (D92). Written only while both sweeps are
# alive, so a sweep dying takes the container unhealthy instead of leaving it
# green with nothing being reconciled. Default /tmp/eoe-worker.heartbeat;
# change it here and in the worker's healthcheck together.
EOE_WORKER_HEARTBEAT_PATH=

# Browser-perspective API URL handed to the frontend dev server; compose
# defaults it to http://localhost:8000.
EOE_FRONTEND_API_URL=

# Dev Postgres container credentials (compose only; keep consistent with
# DATABASE_URL above).
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
